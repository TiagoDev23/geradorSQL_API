# Variaveis de ambiente do backend (apps/api).
# Copie este arquivo para apps/api/.env e preencha os valores locais.
# Nunca versione o arquivo .env preenchido.

# Porta HTTP do servidor NestJS.
PORT=3001

# Conexao com o banco interno da plataforma.
# Em desenvolvimento o container gerador-api-platform-db responde em 127.0.0.1:5434.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# Chave usada pelo CryptoService (AES-256-GCM) para cifrar as senhas dos
# bancos PostgreSQL externos cadastrados pelos usuarios.
# Deve ter 32 bytes em hexadecimal, ou seja, 64 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTION_ENCRYPTION_KEY=

# Segredo de assinatura dos tokens JWT do painel administrativo.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validade do token. Aceita formatos como 15m, 12h, 1d, 7d.
JWT_EXPIRES_IN=1d

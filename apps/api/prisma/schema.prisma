generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DatabaseSslMode {
  DISABLE
  REQUIRE
}

enum QueryParameterType {
  STRING
  INTEGER
  FLOAT
  BOOLEAN
  DATE
  DATETIME
  UUID
}

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  passwordHash String

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  connections DatabaseConnection[]
  endpoints   Endpoint[]
  apiKeys     ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model DatabaseConnection {
  id   String @id @default(uuid())
  name String

  host          String
  port          Int    @default(5432)
  databaseName  String
  defaultSchema String @default("public")
  username      String

  passwordEncrypted String

  sslMode DatabaseSslMode @default(DISABLE)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  savedQueries SavedQuery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model SavedQuery {
  id          String  @id @default(uuid())
  name        String
  description String?

  sql String @db.Text

  connectionId String
  connection   DatabaseConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  parameters QueryParameter[]
  endpoints  Endpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, name])
  @@index([connectionId])
}

model QueryParameter {
  id          String  @id @default(uuid())
  name        String
  description String?

  type     QueryParameterType
  position Int

  required     Boolean @default(true)
  defaultValue String?

  savedQueryId String
  savedQuery   SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([savedQueryId, name])
  @@unique([savedQueryId, position])
  @@index([savedQueryId])
}

model Endpoint {
  id          String  @id @default(uuid())
  name        String
  description String?

  slug    String
  version String @default("v1")

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  maxRows Int @default(1000)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  savedQueryId String
  savedQuery   SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Restrict)

  requestLogs RequestLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version, slug])
  @@index([projectId])
  @@index([savedQueryId])
}

model ApiKey {
  id String @id @default(uuid())

  name      String
  keyPrefix String
  keyHash   String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  requestLogs RequestLog[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

model RequestLog {
  id String @id @default(uuid())

  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  statusCode Int
  durationMs Int
  rowCount   Int?

  errorCode String?

  createdAt DateTime @default(now())

  @@index([endpointId, createdAt])
  @@index([apiKeyId, createdAt])
}

# Variaveis de ambiente do painel web (apps/web).
# Copie este arquivo para apps/web/.env.local e ajuste conforme o ambiente.

# Base da API NestJS. Sem valor, assume http://localhost:3001.
# Precisa estar listada em CORS_ORIGINS no backend quando o painel roda
# em outra origem.
NEXT_PUBLIC_API_URL=http://localhost:3001

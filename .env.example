# Variaveis lidas pelo docker-compose.yml.
# Copie para .env e preencha com valores locais. Nunca versione o .env.
#
# Os segredos da aplicacao (chave de criptografia e segredo do JWT) nao
# ficam aqui: o servico `api` le apps/api/.env, descrito em
# apps/api/.env.example.

# --- PostgreSQL interno da plataforma (host 5434 -> container 5432) ---
POSTGRES_PLATFORM_DB=
POSTGRES_PLATFORM_USER=
POSTGRES_PLATFORM_PASSWORD=

# --- PostgreSQL de demonstracao (host 5435 -> container 5432) ---
# Representa um banco externo cadastrado pelo usuario da plataforma.
POSTGRES_DEMO_DB=
POSTGRES_DEMO_USER=
POSTGRES_DEMO_PASSWORD=

# --- Painel web ---
# Endereco da API a partir do NAVEGADOR, embutido no bundle em tempo de
# build. Dentro do compose a API tambem responde como `api:3001`, mas
# esse nome nao resolve no navegador do host.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origens autorizadas a chamar a API pelo navegador, separadas por
# virgula. Curinga nao e aceito.
CORS_ORIGINS=http://localhost:3000
